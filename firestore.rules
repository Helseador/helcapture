rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un reporte se acepta solo si trae el código de jornada vigente de SU
    // actividad. El código vive en plantillas/{id}.codigoJornada y su
    // vencimiento en plantillas/{id}.codigoExpira.
    function codigoValido(doc) {
      return doc.codigo is string
        && doc.plantillaId is string
        && exists(/databases/$(database)/documents/plantillas/$(doc.plantillaId))
        && get(/databases/$(database)/documents/plantillas/$(doc.plantillaId)).data.codigoJornada == doc.codigo
        && get(/databases/$(database)/documents/plantillas/$(doc.plantillaId)).data.codigoExpira > request.time;
    }

    // Actividades (flujo antiguo, compatibilidad)
    match /actividades/{docId} {
      allow read: if true;
      // Solo se crean con código vigente: aquí se cuela quien no debe
      allow create: if codigoValido(request.resource.data);
      // El panel carga ingresos y costos después, y eso no lleva código
      allow update: if true;
      allow delete: if false;
    }

    // Plantillas y sus reportes
    match /plantillas/{plantillaId} {
      allow read: if true;
      // El panel crea la actividad y le genera el código aquí
      allow write: if true;

      match /reportes/{reporteId} {
        allow read: if true;
        allow create: if codigoValido(request.resource.data);
        allow update: if true;
        allow delete: if false;
      }
    }

    // Usuarios del admin
    match /usuarios/{userId} {
      allow read, write: if true;
    }
  }
}
